{
  "name": "thesis-journey-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": ">=11.16.0 <12"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "cpu-features": false,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "protobufjs": false,
    "sharp": false,
    "ssh2": false,
    "workerd@1.20261006.1": true
  },
  "scripts": {
    "account:create": "node ./scripts/create-auth-user.mjs",
    "auth:create-user": "node ./scripts/create-auth-user.mjs",
    "audit:dependencies": "npm audit --audit-level=low",
    "build:css": "mkdir -p ./.generated && tailwindcss -i ./src/tailwind-input.css -o ./.generated/styles.css --minify",
    "ci:local": "node ./scripts/run-local-ci.mjs run --json --pause-on-failure --workflow .github/workflows/ci.yml --prewarm-through .github/workflows/ci.yml:quality-fast:install",
    "ci:local:quiet": "node ./scripts/run-local-ci.mjs run --json --pause-on-failure --quiet --workflow .github/workflows/ci.yml --prewarm-through .github/workflows/ci.yml:quality-fast:install",
    "ci:local:all": "node ./scripts/run-local-ci.mjs run --json --pause-on-failure --all --prewarm-through .github/workflows/ci.yml:quality-fast:install",
    "ci:local:retry": "node ./scripts/run-local-ci.mjs retry",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "doctor:local": "node ./scripts/doctor-local.mjs",
    "types:generate": "HOME=$PWD wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "types:check": "HOME=$PWD wrangler types worker-configuration.d.ts --check --env-file .dev.vars.example",
    "db:migrate": "wrangler d1 migrations apply thesis_tracker_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply thesis_tracker_db --remote",
    "db:insights": "wrangler d1 insights thesis_tracker_db --time-period 1d --sort-by time --limit 10",
    "db:insights:json": "wrangler d1 insights thesis_tracker_db --time-period 1d --sort-by time --limit 10 --json",
    "db:seed:sample": "wrangler d1 execute thesis_tracker_db --local --file scripts/sample-data.sql",
    "e2e:prepare": "HOME=$PWD wrangler d1 migrations apply thesis_tracker_db --local --persist-to .wrangler/state/e2e --env-file tests/e2e/.env.e2e && HOME=$PWD wrangler d1 execute thesis_tracker_db --local --persist-to .wrangler/state/e2e --env-file tests/e2e/.env.e2e --file tests/e2e/reset-data.sql && HOME=$PWD wrangler d1 execute thesis_tracker_db --local --persist-to .wrangler/state/e2e --env-file tests/e2e/.env.e2e --file tests/e2e/mock-data.sql",
    "e2e:dev": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=200 HOME=$PWD wrangler dev --local --ip 127.0.0.1 --port 8788 --inspector-ip 127.0.0.1 --inspector-port 9230 --log-level error --show-interactive-dev-session=false --persist-to .wrangler/state/e2e --env-file tests/e2e/.env.e2e",
    "e2e:server": "npm run e2e:prepare && npm run e2e:dev",
    "e2e": "playwright test",
    "lighthouse": "node ./scripts/run-lighthouse.mjs",
    "readme:screenshots": "node ./scripts/capture-readme-screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality:gate:fast": "npm run audit:dependencies && npm run types:check && npm run typecheck && npm test && npm run test:d1",
    "quality:gate": "npm run ci:local:quiet",
    "test:d1": "vitest run tests/d1-integration.test.ts",
    "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "pretest": "npm run build:css",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "run-local-ci": "0.18.1",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "htmlisp": "0.90.0"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    }
  },
  "packageManager": "npm@11.21.0",
  "vibeTemplate": {
    "source": "https://github.com/bebraw/vibe-template",
    "baseline": "4428c4351b98769c4ba839d55bc32672ffe02c8b",
    "updates": [
      "2026-07-08-typescript-7-typecheck",
      "2026-07-13-agent-ci-progress-events",
      "2026-08-17-dependency-toolchain-refresh",
      "2026-10-02-scope-agent-guidance"
    ],
    "partialUpdates": [
      {
        "id": "2026-10-02-dependency-refresh",
        "remaining": [
          "Playwright 1.63.0 and its matching CI image: Chromium 153 trace screenshots crash on Linux ARM64."
        ]
      }
    ]
  }
}
